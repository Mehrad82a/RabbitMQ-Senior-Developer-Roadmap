# RabbitMQ Connection
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=your_rabbitmq_username
RABBITMQ_PASS=your_rabbitmq_password

RABBITMQ_VIRTUAL_HOST=/

HEARTBEAT=600
BLOCKED_CONNECTION_TIMEOUT=300
CONNECTION_ATTEMPTS=10
RETRY_DELAY=5
SOCKET_TIMEOUT=10


# RabbitMQ Default Credentials
RABBITMQ_DEFAULT_USER=your_rabbitmq_username
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password

RABBITMQ_DEFAULT_VHOST=/

# Main Task Topology
TASK_EXCHANGE=tasks.exchange
TASK_QUEUE=tasks.queue
TASK_ROUTING_KEY=tasks.process

# Dead-Letter Topology
DEAD_LETTER_EXCHANGE=tasks.dlx
DEAD_LETTER_QUEUE=tasks.dlq
DEAD_LETTER_ROUTING_KEY=tasks.failed

# Consumer
PREFETCH_COUNT=1


# Container Names
RABBITMQ_CONTAINER_NAME=rabbitmq_container
FASTAPI_CONTAINER_NAME=fastapi_container
WORKER_CONTAINER_NAME=worker_container


# Test Environment (used by the pytest integration suite running on the host)
RABBITMQ_TEST_HOST=localhost
RABBITMQ_TEST_PORT=5672

